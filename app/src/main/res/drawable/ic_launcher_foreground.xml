                <item android:offset="1" android:color="#FF6FE0AE" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Click wheel: concentric metal rings with a specular sweep. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,63 A12.5,12.5 0,1 1,54,88 A12.5,12.5 0,1 1,54,63 M54,71 A4.5,4.5 0,1 0,54,80 A4.5,4.5 0,1 0,54,71">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="63"
                android:endX="67"
                android:endY="88"
                android:type="linear">
                <item android:offset="0" android:color="#FFE6FFF2" />
                <item android:offset="0.35" android:color="#FF8AE9BC" />
                <item android:offset="0.7" android:color="#FF2FBF85" />
                <item android:offset="1" android:color="#FF12563C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Wheel centre key. -->
    <path android:pathData="M50,73 L58,73 L58,78 L50,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="73"
                android:endX="58"
                android:endY="78"
                android:type="linear">
                <item android:offset="0" android:color="#FF2A9C6E" />
                <item android:offset="1" android:color="#FF0C3B29" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Specular highlight across the upper face, kept subtle so it reads as metal. -->
    <path android:pathData="M34,27 L74,27 Q77,27 77,30 L77,38 L31,46 L31,30 Q31,27 34,27 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="27"
                android:endX="54"
                android:endY="46"
                android:type="linear">
                <item android:offset="0" android:color="#66FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

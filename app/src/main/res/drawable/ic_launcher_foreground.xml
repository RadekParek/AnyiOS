<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Brushed green metal body: dark rim, lifted face, glossy top band. -->
    <path android:pathData="M34,21 L74,21 Q81,21 81,28 L81,80 Q81,87 74,87 L34,87 Q27,87 27,80 L27,28 Q27,21 34,21 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="27"
                android:startY="21"
                android:endX="81"
                android:endY="87"
                android:type="linear">
                <item android:offset="0" android:color="#FF2F6B54" />
                <item android:offset="0.45" android:color="#FF173D2E" />
                <item android:offset="1" android:color="#FF0B241A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Anodised face plate. -->
    <path android:pathData="M35,25 L73,25 Q78,25 78,30 L78,78 Q78,83 73,83 L35,83 Q30,83 30,78 L30,30 Q30,25 35,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="25"
                android:endX="78"
                android:endY="83"
                android:type="linear">
                <item android:offset="0" android:color="#FF9FF3C6" />
                <item android:offset="0.28" android:color="#FF4DD694" />
                <item android:offset="0.62" android:color="#FF1E9C68" />
                <item android:offset="1" android:color="#FF0B5A3A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Screen inset: dark glass with a cool metal reflection. -->
    <path android:pathData="M39,31 L69,31 Q72,31 72,34 L72,58 Q72,61 69,61 L39,61 Q36,61 36,58 L36,34 Q36,31 39,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="31"
                android:endX="72"
                android:endY="61"
                android:type="linear">
                <item android:offset="0" android:color="#FF0E2A21" />
                <item android:offset="0.55" android:color="#FF123B2C" />
                <item android:offset="1" android:color="#FF071A13" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Play glyph, polished metal. -->
    <path android:pathData="M48,38 L62,46 L48,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="38"
                android:endX="62"
                android:endY="54"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFFFF" />

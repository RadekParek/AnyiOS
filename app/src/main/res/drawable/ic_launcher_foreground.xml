<?xml version="1.0" encoding="utf-8"?>
<!-- Black plate, green anodised-metal engine die: the backend mark, not a phone outline. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Machined outer ring -->
    <path android:pathData="M54,14 L83,31 L83,65 L54,82 L25,65 L25,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="25"
                android:startY="14"
                android:endX="83"
                android:endY="82"
                android:type="linear">
                <item android:offset="0" android:color="#FF6BF0B2" />
                <item android:offset="0.35" android:color="#FF1F8F62" />
                <item android:offset="0.7" android:color="#FF0C5038" />
                <item android:offset="1" android:color="#FF06281C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Recessed dark bevel between ring and die -->
    <path android:pathData="M54,19.5 L78.5,33.6 L78.5,62.4 L54,76.5 L29.5,62.4 L29.5,33.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="29"
                android:startY="20"
                android:endX="79"
                android:endY="77"
                android:type="linear">
                <item android:offset="0" android:color="#FF05140E" />
                <item android:offset="1" android:color="#FF0B2C1F" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Polished die face -->
    <path android:pathData="M54,24 L74,35.4 L74,60.6 L54,72 L34,60.6 L34,35.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="24"
                android:endX="74"
                android:endY="72"
                android:type="linear">
                <item android:offset="0" android:color="#FFB6FFD9" />
                <item android:offset="0.22" android:color="#FF57DDA2" />
                <item android:offset="0.55" android:color="#FF1DA46F" />
                <item android:offset="0.85" android:color="#FF0D6142" />
                <item android:offset="1" android:color="#FF0A3F2C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Trace lines etched into the die -->
    <path
        android:pathData="M43,41 L54,34.5 L65,41 L65,53 L54,59.5 L43,53 Z"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M43,41 L54,47.5 L65,41 M54,47.5 L54,59.5"
        android:strokeColor="#88EFFFFF"
        android:strokeWidth="0.9" />
    <!-- Core: the play/engine glyph -->
    <path android:pathData="M50.5,42.5 L62,48.5 L50.5,54.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="42"
                android:endX="62"
                android:endY="55"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFD6FFE9" />
                <item android:offset="1" android:color="#FF8CF2C1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Contact pins around the package -->
    <path
        android:fillColor="#FF9BF6C8"
        android:pathData="M51,10 L57,10 L57,15 L51,15 Z M51,81 L57,81 L57,86 L51,86 Z" />
    <path
        android:fillColor="#FF4FD39B"
        android:pathData="M18,40 L23,37 L25.5,41.5 L20.5,44.5 Z M18,56 L23,59 L25.5,54.5 L20.5,51.5 Z M85,40 L90,43.5 L87.5,48 L82.5,45 Z M85,56 L90,52.5 L87.5,48 L82.5,51 Z" />
    <!-- Specular sweep across the top half -->
    <path android:pathData="M54,24 L74,35.4 L74,42 L34,50 L34,35.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="50"
                android:type="linear">
                <item android:offset="0" android:color="#7AFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

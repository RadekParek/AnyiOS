diff --git a/externals/oaknut/include/oaknut/code_block.hpp b/externals/oaknut/include/oaknut/code_block.hpp
index bfa87d9..a8b0543 100644
--- a/externals/oaknut/include/oaknut/code_block.hpp
+++ b/externals/oaknut/include/oaknut/code_block.hpp
@@ -7,6 +7,8 @@
 #include <cstddef>
 #include <cstdint>
 #include <new>
+#include <cerrno>
+#include <system_error>
 
 #if defined(_WIN32)
 #    define NOMINMAX
@@ -28,8 +30,12 @@ public:
     explicit CodeBlock(std::size_t size)
         : m_size(size)
     {
-#if defined(_WIN32)
+#if defined(_WIN32) && defined(OAKNUT_USE_WX)
+        m_memory = (std::uint32_t*)VirtualAlloc(nullptr, size, MEM_COMMIT, PAGE_READWRITE);
+#elif defined(_WIN32)
         m_memory = (std::uint32_t*)VirtualAlloc(nullptr, size, MEM_COMMIT, PAGE_EXECUTE_READWRITE);
+#elif defined(OAKNUT_USE_WX)
+        m_memory = (std::uint32_t*)mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
 #elif defined(__APPLE__)
 #    if TARGET_OS_IPHONE
         m_memory = (std::uint32_t*)mmap(nullptr, size, PROT_READ | PROT_EXEC, MAP_ANON | MAP_PRIVATE, -1, 0);
@@ -44,6 +50,12 @@ public:
         m_memory = (std::uint32_t*)mmap(nullptr, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_ANON | MAP_PRIVATE, -1, 0);
 #endif
 
+#if defined(OAKNUT_USE_WX) && !defined(_WIN32)
+        if (m_memory == MAP_FAILED) {
+            m_memory = nullptr;
+            throw std::system_error(errno, std::generic_category(), "oaknut mmap RW");
+        }
+#endif
         if (m_memory == nullptr)
             throw std::bad_alloc{};
     }
@@ -72,7 +84,15 @@ public:
 
     void protect()
     {
-#if defined(__APPLE__) && !TARGET_OS_IPHONE
+#if defined(OAKNUT_USE_WX) && defined(_WIN32)
+        DWORD old_protection = 0;
+        if (!VirtualProtect(m_memory, m_size, PAGE_EXECUTE_READ, &old_protection))
+            throw std::system_error(int(GetLastError()), std::system_category(),
+                                    "oaknut VirtualProtect RX");
+#elif defined(OAKNUT_USE_WX)
+        if (mprotect(m_memory, m_size, PROT_READ | PROT_EXEC) != 0)
+            throw std::system_error(errno, std::generic_category(), "oaknut mprotect RX");
+#elif defined(__APPLE__) && !TARGET_OS_IPHONE
         pthread_jit_write_protect_np(1);
 #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
         mprotect(m_memory, m_size, PROT_READ | PROT_EXEC);
@@ -81,7 +101,15 @@ public:
 
     void unprotect()
     {
-#if defined(__APPLE__) && !TARGET_OS_IPHONE
+#if defined(OAKNUT_USE_WX) && defined(_WIN32)
+        DWORD old_protection = 0;
+        if (!VirtualProtect(m_memory, m_size, PAGE_READWRITE, &old_protection))
+            throw std::system_error(int(GetLastError()), std::system_category(),
+                                    "oaknut VirtualProtect RW");
+#elif defined(OAKNUT_USE_WX)
+        if (mprotect(m_memory, m_size, PROT_READ | PROT_WRITE) != 0)
+            throw std::system_error(errno, std::generic_category(), "oaknut mprotect RW");
+#elif defined(__APPLE__) && !TARGET_OS_IPHONE
         pthread_jit_write_protect_np(0);
 #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
         mprotect(m_memory, m_size, PROT_READ | PROT_WRITE);
diff --git a/src/dynarmic/backend/x64/a32_emit_x64.cpp b/src/dynarmic/backend/x64/a32_emit_x64.cpp
index fc8e8ba..77c383a 100644
--- a/src/dynarmic/backend/x64/a32_emit_x64.cpp
+++ b/src/dynarmic/backend/x64/a32_emit_x64.cpp
@@ -83,12 +83,14 @@ A32EmitX64::A32EmitX64(BlockOfCode& code, A32::UserConfig conf, A32::Jit* jit_in
         : EmitX64(code), conf(std::move(conf)), jit_interface(jit_interface) {
     GenFastmemFallbacks();
     GenTerminalHandlers();
-    code.PreludeComplete();
-    ClearFastDispatchTable();
-
+    // The Windows exception handler stores its callback selector in the code block's
+    // unwind metadata. Set it before the prelude becomes RX on W^X builds.
     exception_handler.SetFastmemCallback([this](u64 rip_) {
         return FastmemCallback(rip_);
     });
+
+    code.PreludeComplete();
+    ClearFastDispatchTable();
 }
 
 A32EmitX64::~A32EmitX64() = default;

+/* AnyiOS: Android's reported SurfaceView buffer size can differ from the EGL
+   window surface during fixed-size changes or when a driver ignores the request.
+   SDL_GL_GetDrawableSize must describe the surface actually being drawn to;
+   otherwise the viewport covers only part of the screen. */
+void
+Android_GLES_GetDrawableSize(_THIS, SDL_Window *window, int *w, int *h)
+{
+    EGLint egl_width = 0, egl_height = 0;
+    int width, height;
+    SDL_WindowData *data;
+
+    SDL_LockMutex(Android_ActivityMutex);
+    data = (SDL_WindowData *)window->driverdata;
+    width = window->w;
+    height = window->h;
+    if (data && _this->egl_data && _this->egl_data->eglQuerySurface &&
+        _this->egl_data->egl_display != EGL_NO_DISPLAY &&
+        data->egl_surface != EGL_NO_SURFACE) {
+        EGLBoolean width_ok = _this->egl_data->eglQuerySurface(_this->egl_data->egl_display,
+                                                               data->egl_surface, EGL_WIDTH, &egl_width);
+        EGLBoolean height_ok = width_ok && _this->egl_data->eglQuerySurface(_this->egl_data->egl_display,
+                                                                           data->egl_surface, EGL_HEIGHT, &egl_height);
+        if (width_ok && height_ok && egl_width > 0 && egl_height > 0) {
+            width = egl_width;
+            height = egl_height;
+        } else if ((!width_ok || !height_ok) && _this->egl_data->eglGetError) {
+            /* Do not leave our failed optional query as a pending EGL error. */
+            _this->egl_data->eglGetError();
+        }
+    }
+    SDL_UnlockMutex(Android_ActivityMutex);
+    if (w) *w = width;
+    if (h) *h = height;
+}

+#[test]
+fn scheduled_notifications_change_once_and_reset_after_callback_replacement() {
+    let timer = id::from_bits(0x1234);
+    let run_loop = id::from_bits(0x3456);
+    let mut host = SCNetworkReachabilityHostObject::default();
+    host.schedules.push(ReachabilitySchedule {
+        run_loop, mode: "default".to_string(), timer, last_flags: None,
+    });
+    assert!(!host.changed_for_timer(timer, 0)); // no callback registered
+    let callback = Some(GuestFunction::from_addr_with_thumb_bit(0x1001));
+    host.replace_callback(callback, None);
+    assert!(host.changed_for_timer(timer, 0));
+    assert!(!host.changed_for_timer(timer, 0));
+    assert!(host.changed_for_timer(timer, kSCNetworkReachabilityFlagsReachable));
+    assert!(!host.changed_for_timer(id::from_bits(0x5678), 0));
+    host.replace_callback(callback, None);
+    assert!(host.changed_for_timer(timer, kSCNetworkReachabilityFlagsReachable));
+    host.schedules.clear();
+    assert!(!host.changed_for_timer(timer, 0));
+}

+        .audio_toolbox
+        .make_al_context_current(&mut env.openal_manager);
+    for source in sources {
+        unsafe {
+            context.SourceStop(source);
+            let mut queued = 0;
+            context.GetSourcei(source, AL_BUFFERS_QUEUED, &mut queued);
+            let mut buffers = vec![0; queued.clamp(0, 1024) as usize];
+            if !buffers.is_empty() {
+                context.SourceUnqueueBuffers(source, buffers.len() as i32, buffers.as_mut_ptr());
+            }
+            context.DeleteSources(1, &source);

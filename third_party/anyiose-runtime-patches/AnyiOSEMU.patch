@@ -0,0 +1,31 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+package org.anyiose.android;
+
+/** A drawable-pixel rectangle, normalized so surface-buffer changes do not move UI. */
+final class OverlayGeometry {
+    final float x, y, width, height;
+
+    private OverlayGeometry(float x, float y, float width, float height) {
+        this.x = x;
+        this.y = y;
+        this.width = width;
+        this.height = height;
+    }
+
+    static OverlayGeometry fromDrawable(int x, int y, int width, int height,
+                                         int drawableWidth, int drawableHeight) {
+        float dw = Math.max(1, drawableWidth), dh = Math.max(1, drawableHeight);
+        return new OverlayGeometry(x / dw, y / dh,
+                width > 0 ? width / dw : -1, height > 0 ? height / dh : -1);
+    }
+
+    int[] inView(int viewWidth, int viewHeight, int offsetX, int offsetY) {
+        return new int[] {offsetX + Math.round(x * viewWidth), offsetY + Math.round(y * viewHeight),
+                width < 0 ? -1 : Math.max(1, Math.round(width * viewWidth)),
+                height < 0 ? -1 : Math.max(1, Math.round(height * viewHeight))};
+    }
+}

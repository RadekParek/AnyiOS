+/// CMMagneticField uses device-relative microteslas, just like Android's
+/// magnetic field sensors. See https://developer.apple.com/documentation/coremotion/cmmagneticfield
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+#[repr(C, packed)]
+struct CMMagneticField {
+    x: f64,
+    y: f64,
+    z: f64,

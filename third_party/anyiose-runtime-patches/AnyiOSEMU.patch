diff --git a/src/frameworks/core_animation/composition_pacing.rs b/src/frameworks/core_animation/composition_pacing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..07a2025bea44d52e7af0d813e69645210ba10bce
--- /dev/null
+++ b/src/frameworks/core_animation/composition_pacing.rs
@@ -0,0 +1,84 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Deadline accounting for the Core Animation composition path.
+use std::time::{Duration, Instant};
+
+/// Keep a fixed-rate schedule even when a forced frame arrives early; skip
+/// missed deadlines rather than rendering a burst of catch-up frames.
+pub(super) fn composition_schedule(
+    next: Option<Instant>,
+    now: Instant,
+    force: bool,
+    interval: Duration,
+) -> (bool, Instant) {
+    let Some(next) = next else {
+        return (true, now.checked_add(interval).unwrap_or(now));
+    };
+    if next > now {
+        return (force, next);
+    }
+    let overdue = now.duration_since(next);
+    let intervals =
+        ((overdue.as_secs_f64() / interval.as_secs_f64()).floor() as u32).saturating_add(1);
+    let future = interval
+        .checked_mul(intervals)
+        .and_then(|delta| next.checked_add(delta))
+        .filter(|deadline| *deadline > now)
+        .unwrap_or_else(|| now.checked_add(interval).unwrap_or(now));
+    (true, future)
+}
+#[cfg(test)]
+mod pacing_tests {
+    use super::*;
+    #[test]
+    fn forced_early_frames_do_not_postpone_normal_deadlines() {
+        let start = Instant::now();
+        let interval = Duration::from_millis(16);
+        let mut next = None;
+        for frame in 0..1000u64 {
+            let now = start + Duration::from_millis(frame * 8);
+            let (draw, deadline) = composition_schedule(next, now, true, interval);
+            assert!(draw && deadline > now && deadline <= now + interval);
+            next = Some(deadline);
+        }
+        let now = start + Duration::from_millis(8000);
+        assert_eq!(
+            composition_schedule(next, now, false, interval),
+            (true, now + interval)
+        );
+    }
+    #[test]
+    fn early_and_late_frames_keep_phase_without_catchup_bursts() {
+        let start = Instant::now();
+        let interval = Duration::from_millis(16);
+        let next = start + interval;
+        assert_eq!(
+            composition_schedule(Some(next), start, false, interval),
+            (false, next)
+        );
+        assert_eq!(
+            composition_schedule(Some(next), start, true, interval),
+            (true, next)
+        );
+        assert_eq!(
+            composition_schedule(Some(next), next, false, interval),
+            (true, next + interval)
+        );
+        assert_eq!(
+            composition_schedule(Some(next), next + interval * 3, false, interval),
+            (true, next + interval * 4)
+        );
+        assert_eq!(
+            composition_schedule(
+                Some(next),
+                next + interval * 3 + Duration::from_millis(2),
+                false,
+                interval
+            ),
+            (true, next + interval * 4)
+        );
+    }
+}

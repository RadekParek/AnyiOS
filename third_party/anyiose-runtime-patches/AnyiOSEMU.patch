+#[derive(Default)]
+pub(super) struct WarningBudget {
+    count: usize,
+}
+impl WarningBudget {
+    fn next(&mut self) -> usize {
+        self.count = self.count.saturating_add(1).min(5);
+        if self.count <= 4 {
+            self.count
+        } else {
+            0
+        }
+    }
+}
+fn warn_invalid_selector_name(budget: &mut WarningBudget, name: ConstPtr<u8>, reason: &str) {
+    match budget.next() {
+        1..=3 => log!(
+            "Warning: sel_registerName({:?}): {}; returning null selector",
+            name,
+            reason
+        ),
+        4 => log!("Warning: additional invalid selector-name messages suppressed for this session"),
+        _ => (),
+    }
+}
+fn warn_non_utf8_selector_once(budget: &mut WarningBudget, sel_cstr: ConstPtr<u8>) {
+    match budget.next() {
+        1..=3 => log!(
+            "Warning: skipping binary selector at {:?}: invalid UTF-8",
             sel_cstr
+        ),
+        4 => {
+            log!("Warning: additional invalid binary selector messages suppressed for this session")
+        }
+        _ => (),
+    }
+}
+#[cfg(test)]
+mod selector_diagnostic_tests {
+    use super::*;
+    #[test]
+    fn warnings_are_session_bounded() {
+        let mut b = WarningBudget::default();
+        assert_eq!(
+            (0..8).map(|_| b.next()).collect::<Vec<_>>(),
+            vec![1, 2, 3, 4, 0, 0, 0, 0]
         );
     }
+    #[test]
+    fn null_selector_name_is_stable() {
+        let (mut objc, mut mem) = (ObjC::new(), Mem::new());
+        let name = selector_name(&mut objc, &mut mem, SEL::null());
+        assert_eq!(mem.cstr_at_utf8(name).unwrap(), "<null selector>");
+        assert_eq!(name, selector_name(&mut objc, &mut mem, SEL::null()));
+    }
 }

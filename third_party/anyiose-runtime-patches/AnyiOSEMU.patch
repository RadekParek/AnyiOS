@@ -0,0 +1,64 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+package org.anyiose.android;
+
+import java.util.Objects;
+
+/** Ordered default-network events; this class has no Android or JNI dependencies. */
+public final class NetworkRouteTracker<T> {
+    public static final int UNKNOWN = -1, NONE = 0, WIFI = 1, CELLULAR = 2, OTHER = 3;
+    private T current;
+    private int transport = UNKNOWN;
+    private boolean blocked, blockKnown;
+
+    public int snapshot(T network, int route) {
+        current = network;
+        transport = network == null ? NONE : route;
+        blocked = false;
+        blockKnown = true; // getActiveNetwork excludes networks blocked for this app.
+        return value();
+    }
+
+    public int available(T network) {
+        current = network;
+        transport = UNKNOWN;
+        blocked = true;
+        blockKnown = false;
+        return value();
+    }
+
+    public int capabilities(T network, int route) {
+        if (current != null && Objects.equals(current, network))
+            transport = route;
+        return value();
+    }
+
+    public int blocked(T network, boolean isBlocked) {
+        if (current != null && Objects.equals(current, network)) {
+            blocked = isBlocked;
+            blockKnown = true;
+        }
+        return value();
+    }
+
+    public int lost(T network) {
+        if (current != null && Objects.equals(current, network)) {
+            current = null;
+            transport = NONE;
+            blocked = false;
+            blockKnown = true;
+        }
+        return value();
+    }
+
+    public int value() {
+        if (current == null)
+            return transport == UNKNOWN ? UNKNOWN : NONE;
+        if (!blockKnown)
+            return UNKNOWN;
+        return blocked ? NONE : transport;
+    }
+}

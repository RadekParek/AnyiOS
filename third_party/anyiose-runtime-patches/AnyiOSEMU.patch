+// Apple documents that the pull-mode property is nil when updates have not
+// started or no sample is available:
+// https://developer.apple.com/documentation/coremotion/cmmotionmanager/magnetometerdata
+fn start_magnetometer(env: &mut Environment, this: id) {
+    if env
+        .objc
+        .borrow::<CMMotionManagerHostObject>(this)
+        .magnetometer_active
+    {
+        return;
+    }
+    let started = env.window.is_some()
+        && env.on_parent_stack_in_coroutine(|window, _| window.start_magnetometer());
+    env.objc
+        .borrow_mut::<CMMotionManagerHostObject>(this)
+        .magnetometer_active = started;
+}
+
+fn stop_magnetometer(env: &mut Environment, this: id) {
+    let active = env
+        .objc
+        .borrow::<CMMotionManagerHostObject>(this)
+        .magnetometer_active;
+    if !active {
+        return;
+    }
+    env.objc
+        .borrow_mut::<CMMotionManagerHostObject>(this)
+        .magnetometer_active = false;
+    if env.window.is_some() {
+        env.on_parent_stack_in_coroutine(|window, _| window.stop_magnetometer());
+    }
+}

+/// Map a guest rectangle into the *drawable* viewport, using the same rotated
+/// guest extent as presentation and input. The host view may subsequently
+/// scale this drawable (for example, Android's fixed-size surface buffers).
+pub(super) fn guest_rect_to_drawable(
+    (x, y, width, height): (f32, f32, f32, f32),
+    (guest_width, guest_height): (u32, u32),
+    orientation: super::DeviceOrientation,
+    (vx, vy, vw, vh): (u32, u32, u32, u32),
+) -> (i32, i32, i32, i32) {
+    if guest_width == 0 || guest_height == 0 || vw == 0 || vh == 0 {
+        return (0, 0, 0, 0);
+    }
+    let (gw, gh) = (guest_width as f32, guest_height as f32);
+    let (x, y, width, height, oriented_width, oriented_height) = match orientation {
+        super::DeviceOrientation::Portrait => (x, y, width, height, gw, gh),
+        super::DeviceOrientation::PortraitUpsideDown => {
+            (gw - x - width, gh - y - height, width, height, gw, gh)
+        }
+        super::DeviceOrientation::LandscapeLeft => (y, gw - x - width, height, width, gh, gw),
+        super::DeviceOrientation::LandscapeRight => (gh - y - height, x, height, width, gh, gw),
+    };
+    let sx = vw as f32 / oriented_width;
+    let sy = vh as f32 / oriented_height;
+    (
+        (vx as f32 + x * sx).round() as i32,
+        (vy as f32 + y * sy).round() as i32,
+        ((width * sx).round() as i32).max(0),
+        ((height * sy).round() as i32).max(0),
+    )
+}
+

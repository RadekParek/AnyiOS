+/// Recent initialization calls only, never sample data or guest strings.
+/// The fixed-size ring is printed at guest assertions rather than spamming logs.
+#[derive(Default)]
+struct AudioDiagnostics(std::collections::VecDeque<String>);
+
+impl AudioDiagnostics {
+    const CAPACITY: usize = 32;
+    fn record(&mut self, event: String) {
+        if self.0.len() == Self::CAPACITY {
+            self.0.pop_front();
+        }
+        self.0.push_back(event);
+    }
+}
+
+pub(crate) fn record_audio_event(env: &mut crate::Environment, event: String) {
+    let thread = env.current_thread;
+    env.framework_state
+        .audio_toolbox
+        .audio_diagnostics
+        .record(format!("thread {thread}: {event}"));
+}
+
+pub(crate) fn dump_audio_diagnostics(env: &crate::Environment) {
+    let events = &env.framework_state.audio_toolbox.audio_diagnostics.0;
+    if events.is_empty() {
+        echo!("Audio diagnostics: no recorded AudioSession or AudioUnit setup calls.");
+    } else {
+        echo!("Audio diagnostics: recent setup calls (status is the emulated API result):");
+        for event in events {
+            echo!("  {}", event);
+        }
+    }
+    echo!("Audio diagnostics do not identify a guest sound library's own return value.");
+}
+
+#[cfg(test)]
+mod diagnostics_tests {
+    use super::AudioDiagnostics;
+    #[test]
+    fn setup_history_is_bounded_and_keeps_the_latest_events() {
+        let mut history = AudioDiagnostics::default();
+        for i in 0..40 {
+            history.record(i.to_string());
+        }
+        assert_eq!(history.0.len(), AudioDiagnostics::CAPACITY);
+        assert_eq!(history.0.front().unwrap(), "8");
+        assert_eq!(history.0.back().unwrap(), "39");
+    }
+}
+
 #[derive(Default)]
 pub struct LazyALContext(Option<OpenALContext>);
 

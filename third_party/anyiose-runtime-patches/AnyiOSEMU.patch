diff --git a/android/app/src/main/java/org/touchhle/android/NetworkRouteMonitor.java b/android/app/src/main/java/org/touchhle/android/NetworkRouteMonitor.java
new file mode 100644
index 0000000000000000000000000000000000000000..f3d37be73d7ca923ca65e50b9508535c81e80769
--- /dev/null
+++ b/android/app/src/main/java/org/touchhle/android/NetworkRouteMonitor.java
@@ -0,0 +1,110 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+package org.anyiose.android;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+
+/** Sends the app's changing default route to native code without JNI from a guest stack. */
+final class NetworkRouteMonitor {
+    private static final String TAG = "AnyiOSEMU";
+    // A destroyed, older activity must not overwrite a replacement activity's state.
+    private static NetworkRouteMonitor active;
+    private final ConnectivityManager manager;
+    private final NetworkRouteTracker<Network> tracker = new NetworkRouteTracker<>();
+    private boolean registered;
+
+    private static native void nativeSetNetworkRoute(int route);
+
+    NetworkRouteMonitor(Context context) {
+        manager = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
+    }
+
+    // All callbacks and lifecycle methods run on the main looper. Android says not
+    // to perform synchronous ConnectivityManager queries inside callbacks: use
+    // their ordered arguments instead. See:
+    // https://developer.android.com/reference/android/net/ConnectivityManager.NetworkCallback
+    private final ConnectivityManager.NetworkCallback callback =
+        new ConnectivityManager.NetworkCallback() {
+            @Override public void onAvailable(Network network) {
+                publish(tracker.available(network));
+            }
+            @Override public void onCapabilitiesChanged(Network network, NetworkCapabilities caps) {
+                publish(tracker.capabilities(network, route(caps)));
+            }
+            @Override public void onBlockedStatusChanged(Network network, boolean blocked) {
+                publish(tracker.blocked(network, blocked));
+            }
+            @Override public void onLost(Network network) {
+                publish(tracker.lost(network));
+            }
+        };
+
+    void start() {
+        active = this;
+        if (manager == null) {
+            publish(NetworkRouteTracker.UNKNOWN);
+            return;
+        }
+        try {
+            // Register before the initial snapshot. The handler serializes queued
+            // callbacks after this UI-thread snapshot, including handovers.
+            manager.registerDefaultNetworkCallback(callback, new Handler(Looper.getMainLooper()));
+            registered = true;
+            Network network = manager.getActiveNetwork();
+            NetworkCapabilities caps = network == null ? null : manager.getNetworkCapabilities(network);
+            publish(tracker.snapshot(network, route(caps)));
+        } catch (RuntimeException error) {
+            Log.w(TAG, "Could not monitor the app's default network", error);
+            publish(NetworkRouteTracker.UNKNOWN);
+        }
+    }
+
+    void stop() {
+        if (registered) {
+            try {
+                manager.unregisterNetworkCallback(callback);
+            } catch (RuntimeException error) {
+                Log.w(TAG, "Could not unregister network monitor", error);
+            }
+            registered = false;
+        }
+        if (active == this) {
+            publish(NetworkRouteTracker.UNKNOWN);
+            active = null;
+        }
+    }
+
+    private static int route(NetworkCapabilities caps) {
+        if (caps == null)
+            return NetworkRouteTracker.UNKNOWN;
+        if (!caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_SUSPENDED))
+            return NetworkRouteTracker.NONE;
+        boolean wifi = caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI);
+        boolean cellular = caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR);
+        if (wifi && !cellular)
+            return NetworkRouteTracker.WIFI;
+        if (cellular && !wifi)
+            return NetworkRouteTracker.CELLULAR;
+        return NetworkRouteTracker.OTHER; // VPN, ethernet, or an ambiguous underlying path.
+    }
+
+    private void publish(int route) {
+        if (active != this)
+            return;
+        try {
+            nativeSetNetworkRoute(route);
+        } catch (UnsatisfiedLinkError error) {
+            // SDL may have failed to load the native runtime; do not crash its host.
+            Log.w(TAG, "Native network state bridge is unavailable", error);
+        }
+    }
+}

+// Promote only a 60-FPS request, and only with explicit opt-in. Apps that
+// advance simulation by callback count may run too fast with this enabled.
+fn effective_link_fps(requested: NSInteger, maximum: NSInteger, boost: bool) -> NSInteger {
+    if requested <= 0 || (boost && requested == 60 && maximum > 60) {
+        maximum
+    } else {
+        requested.min(maximum).max(1)
+    }
+}
+
+#[cfg(test)]
+mod fps_tests {
+    use super::effective_link_fps;
+    #[test]
+    fn boost_promotes_only_60_and_respects_the_cap() {
+        assert_eq!(effective_link_fps(60, 120, false), 60);
+        assert_eq!(effective_link_fps(60, 120, true), 120);
+        assert_eq!(effective_link_fps(30, 120, true), 30);
+        assert_eq!(effective_link_fps(120, 60, true), 60);
+        assert_eq!(effective_link_fps(0, 120, false), 120);
+    }
+}

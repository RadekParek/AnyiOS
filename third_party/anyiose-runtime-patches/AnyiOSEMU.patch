diff --git a/src/android_network.rs b/src/android_network.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4c6fec76f8c5e0b345b90a879c239632dfa17aa3
--- /dev/null
+++ b/src/android_network.rs
@@ -0,0 +1,89 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Android default-network state, published by Java without calling JNI from
+//! the guest's coroutine stack. It is only a route hint, not a server probe.
+
+use std::sync::atomic::{AtomicI32, Ordering};
+
+pub const UNKNOWN: i32 = -1;
+pub const NONE: i32 = 0;
+pub const WIFI: i32 = 1;
+pub const CELLULAR: i32 = 2;
+pub const OTHER: i32 = 3;
+
+static ROUTE: AtomicI32 = AtomicI32::new(UNKNOWN);
+
+#[cfg(target_os = "android")]
+#[no_mangle]
+pub extern "system" fn Java_org_anyiose_android_NetworkRouteMonitor_nativeSetNetworkRoute(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    route: i32,
+) {
+    set_route(route);
+}
+
+fn set_route(route: i32) {
+    let route = match route {
+        NONE | WIFI | CELLULAR | OTHER => route,
+        _ => UNKNOWN,
+    };
+    ROUTE.store(route, Ordering::Release);
+}
+
+pub fn route() -> i32 {
+    ROUTE.load(Ordering::Acquire)
+}
+
+/// SCNetworkReachability is a route hint; an apparent route does not promise
+/// DNS, Internet access or a response from the specific host. Apple says to
+/// attempt the request rather than preflight it:
+/// https://developer.apple.com/library/archive/documentation/NetworkingInternetWeb/Conceptual/NetworkingOverview/WhyNetworkingIsHard/WhyNetworkingIsHard.html
+pub fn reachability_flags(network_access: bool, iap_emulation: bool, route: i32) -> u32 {
+    const REACHABLE: u32 = 1 << 1;
+    const IS_WWAN: u32 = 1 << 18;
+    if !network_access {
+        // Preserve the explicit local-StoreKit compatibility option when real
+        // networking is disabled; this hint itself never enables transport.
+        return if iap_emulation { REACHABLE } else { 0 };
+    }
+    match route {
+        WIFI | OTHER => REACHABLE,
+        CELLULAR => REACHABLE | IS_WWAN,
+        _ => 0,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn route_changes_are_visible_and_unknown_values_do_not_claim_a_route() {
+        set_route(WIFI);
+        assert_eq!(route(), WIFI);
+        set_route(CELLULAR);
+        assert_eq!(route(), CELLULAR);
+        set_route(NONE);
+        assert_eq!(route(), NONE);
+        set_route(900);
+        assert_eq!(route(), UNKNOWN);
+    }
+
+    #[test]
+    fn flags_reflect_route_and_never_enable_real_network_transport() {
+        const REACHABLE: u32 = 1 << 1;
+        const WWAN: u32 = 1 << 18;
+        assert_eq!(reachability_flags(true, false, UNKNOWN), 0);
+        assert_eq!(reachability_flags(true, false, NONE), 0);
+        assert_eq!(reachability_flags(true, true, NONE), 0);
+        assert_eq!(reachability_flags(true, false, WIFI), REACHABLE);
+        assert_eq!(reachability_flags(true, false, OTHER), REACHABLE);
+        assert_eq!(reachability_flags(true, false, CELLULAR), REACHABLE | WWAN);
+        assert_eq!(reachability_flags(false, false, WIFI), 0);
+        assert_eq!(reachability_flags(false, true, NONE), REACHABLE);
+    }
+}

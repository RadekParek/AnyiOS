+fn release_audio_unit_sources(env: &mut Environment, unit: AudioUnit) {
+    let sources = audio_components::State::get(&mut env.framework_state)
+        .audio_component_instances
+        .get_mut(&unit)
+        .map(|obj| obj.take_sources())
+        .unwrap_or_default();

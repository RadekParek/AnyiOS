diff --git a/src/fs/ipa_names.rs b/src/fs/ipa_names.rs
new file mode 100644
index 0000000000000000000000000000000000000000..374584ff421ca18a85fbdbaba8c6cb4c8d91eb8d
--- /dev/null
+++ b/src/fs/ipa_names.rs
@@ -0,0 +1,53 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+/// Normalize archive separators and dot components without admitting traversal.
+/// Preserve colons: unlike the Android extractor's host-safe filenames, these
+/// are guest paths and valid resource names must stay byte-for-byte accessible.
+pub(super) fn normalized_member_name(name: &str) -> Option<String> {
+    if name.contains('\0') {
+        return None;
+    }
+    let name = name.replace('\\', "/");
+    let mut parts = Vec::new();
+    for part in name.split('/') {
+        if part == ".." {
+            return None;
+        }
+        if !part.is_empty() && part != "." {
+            parts.push(part);
+        }
+    }
+    if parts.is_empty() {
+        None
+    } else {
+        Some(parts.join("/"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::normalized_member_name;
+
+    #[test]
+    fn normalized_names_preserve_guest_resources_and_reject_traversal() {
+        assert_eq!(
+            normalized_member_name("./Payload//Game.app/./Info.plist").as_deref(),
+            Some("Payload/Game.app/Info.plist")
+        );
+        assert_eq!(
+            normalized_member_name("\\Payload\\Game.app\\Data\\foo").as_deref(),
+            Some("Payload/Game.app/Data/foo")
+        );
+        assert_eq!(
+            normalized_member_name("Payload/Game.app/Level:One.dat").as_deref(),
+            Some("Payload/Game.app/Level:One.dat")
+        );
+        assert!(normalized_member_name("Payload/Game.app/../outside").is_none());
+        assert!(normalized_member_name("Payload/Game.app/..\\outside").is_none());
+        assert!(normalized_member_name("///./").is_none());
+        assert!(normalized_member_name("Payload/\0bad").is_none());
+    }
+}

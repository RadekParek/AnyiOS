diff --git a/src/window/magnetometer.rs b/src/window/magnetometer.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c82cebf9d37c4194394d0ea5ebeefffa4aca017e
--- /dev/null
+++ b/src/window/magnetometer.rs
@@ -0,0 +1,84 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! Android magnetic-field sensor selection and sample validation.
+
+/// Android sensor types 14 and 2 are uncalibrated and calibrated fields,
+/// respectively; both use microteslas and the same device axes as iOS.
+pub(super) fn priority(android_type: i32) -> u8 {
+    match android_type {
+        14 => 2,
+        2 => 1,
+        _ => 0,
+    }
+}
+
+/// Share one open SDL sensor across independently started motion managers.
+#[derive(Default)]
+pub(super) struct Clients(usize);
+
+impl Clients {
+    pub(super) fn acquire(&mut self) {
+        self.0 = self.0.saturating_add(1);
+    }
+
+    /// Return true only when the last real client has just stopped.
+    pub(super) fn release(&mut self) -> bool {
+        if self.0 == 0 {
+            return false;
+        }
+        self.0 -= 1;
+        self.0 == 0
+    }
+}
+
+/// SDL exposes the Android boot-relative timestamp in microseconds. Do not
+/// report a sample until the sensor has delivered one, or pass NaNs to a guest.
+pub(super) fn sample(data: [f32; 6], timestamp_us: u64) -> Option<((f32, f32, f32), f64)> {
+    if timestamp_us == 0 || !data[0..3].iter().all(|value| value.is_finite()) {
+        return None;
+    }
+    Some((
+        (data[0], data[1], data[2]),
+        timestamp_us as f64 / 1_000_000.0,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{priority, sample, Clients};
+
+    // https://developer.apple.com/documentation/coremotion/cmmagnetometerdata
+    // CMMagneticField represents three device-relative values in microteslas.
+    #[test]
+    fn prefers_raw_sensor_and_preserves_axes_and_units() {
+        assert!(priority(14) > priority(2));
+        assert_eq!(priority(1), 0);
+        assert_eq!(
+            sample([12.5, -31.0, 8.25, 1.0, 2.0, 3.0], 2_500_000),
+            Some(((12.5, -31.0, 8.25), 2.5))
+        );
+    }
+
+    #[test]
+    fn shared_sensor_closes_only_after_the_last_manager_stops() {
+        let mut clients = Clients::default();
+        assert!(!clients.release());
+        clients.acquire();
+        clients.acquire();
+        assert!(!clients.release());
+        assert!(clients.release());
+        assert!(!clients.release());
+        clients.acquire();
+        assert!(clients.release());
+    }
+
+    #[test]
+    fn unavailable_and_invalid_samples_are_not_fabricated() {
+        assert_eq!(sample([0.0; 6], 0), None);
+        assert_eq!(sample([f32::NAN, 1.0, 2.0, 0.0, 0.0, 0.0], 1), None);
+        assert_eq!(sample([0.0; 6], 1), Some(((0.0, 0.0, 0.0), 0.000001)));
+    }
+}

+/// Check the raw n_type byte because mach_object 0.1.17 exposes N_EXT but
+/// discards N_PEXT. Private externs can retain N_EXT when linked with
+/// -keep_private_externs, but are not exports of the dynamic library.
+/// https://github.com/apple-oss-distributions/xnu/blob/main/EXTERNAL_HEADERS/mach-o/nlist.h
+/// https://github.com/aidansteele/osx-abi-macho-file-format-reference#nlist
+pub(super) fn is_public_external_symbol(
+    bytes: &[u8],
+    symoff: u32,
+    index: usize,
+    is_64bit: bool,
+) -> bool {
+    const N_STAB: u8 = 0xe0;
+    const N_PEXT: u8 = 0x10;
+    const N_EXT: u8 = 0x01;
+    let size: usize = if is_64bit { 16 } else { 12 };
+    let entry = index
+        .checked_mul(size)
+        .and_then(|n| (symoff as usize).checked_add(n))
+        .and_then(|start| {
+            start
+                .checked_add(size)
+                .and_then(|end| bytes.get(start..end))
+        });
+    let Some(entry) = entry else { return false };
+    let flags = entry[4];
+    flags & N_EXT != 0 && flags & (N_PEXT | N_STAB) == 0
+}

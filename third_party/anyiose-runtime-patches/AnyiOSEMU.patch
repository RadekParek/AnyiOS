+    #[test]
+    fn recognizes_only_public_externs_for_both_symbol_sizes() {
+        for (is_64bit, size) in [(false, 12), (true, 16)] {
+            let offset = 7;
+            let mut table = vec![0; offset + 4 * size];
+            table[offset + 4] = 0x0f; // N_SECT | N_EXT
+            table[offset + size + 4] = 0x1f; // N_SECT | N_EXT | N_PEXT
+            table[offset + 2 * size + 4] = 0x0e; // N_SECT (local)
+            table[offset + 3 * size + 4] = 0xef; // N_STAB | N_EXT
+            assert!(is_public_external_symbol(
+                &table,
+                offset as u32,
+                0,
+                is_64bit
+            ));
+            for index in 1..4 {
+                assert!(!is_public_external_symbol(
+                    &table,
+                    offset as u32,
+                    index,
+                    is_64bit
+                ));
+            }
+            assert!(!is_public_external_symbol(
+                &table,
+                offset as u32,
+                4,
+                is_64bit
+            ));
+            assert!(!is_public_external_symbol(
+                &table[..offset + 5],
+                offset as u32,
+                0,
+                is_64bit
+            ));
+            assert!(!is_public_external_symbol(
+                &table,
+                offset as u32,
+                usize::MAX,
+                is_64bit
+            ));
+        }
+    }
+}
